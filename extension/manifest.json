{
  "manifest_version": 3,
  "name": "Universal Voice Volume Controller",
  "version": "1.4",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://open.spotify.com/*"],
      "js": ["spotify_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["prank.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}